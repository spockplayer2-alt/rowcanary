{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spockplayer2-alt/rowcanary/report.schema.json",
  "title": "RowCanary report schema 1.0",
  "oneOf": [{"$ref": "#/$defs/report"}, {"$ref": "#/$defs/batch"}],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "ident", "reason", "expected", "actual", "severity", "classifications", "observation", "possible_causes", "guidance", "expected_type", "actual_type"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "ident": {"type": "string"},
        "reason": {"type": "string"},
        "expected": {"type": ["string", "null"]},
        "actual": {"type": ["string", "null"]},
        "severity": {"enum": ["error", "warning", "info"]},
        "classifications": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "observation": {"type": "string", "minLength": 1},
        "possible_causes": {"type": "array", "items": {"type": "string"}},
        "guidance": {"type": "string", "minLength": 1},
        "expected_type": {"type": ["string", "null"]},
        "actual_type": {"type": ["string", "null"]}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ok", "passed", "total", "input", "issues", "observations"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "ok": {"type": "boolean"},
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "input": {"type": "string"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "error"],
      "properties": {"input": {"type": "string"}, "error": {"type": "string"}}
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "results"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "results": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/report"}, {"$ref": "#/$defs/error"}]}}
      }
    }
  }
}
